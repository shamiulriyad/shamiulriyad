  classDef navy fill:#E7EDF5,stroke:#1F3A5F,color:#1F3A5F;
  classDef amber fill:#FBF1DF,stroke:#B7791F,color:#B7791F;
  class A,B,D teal; class C,E,F,G navy; class H,I amber;
